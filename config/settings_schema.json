      {
        "type": "header",
        "content": "Store copy"
      },
      {
        "type": "paragraph",
        "content": "Every text in the theme has an English and an Arabic version. To change any wording (buttons, labels, messages) open Online Store → Themes → … → Edit default theme content, or install Shopify's free Translate & Adapt app to edit Arabic side by side."
      }
