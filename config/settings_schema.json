[
  {
    "name": "theme_info",
    "theme_name": "LINUX Liquid Glass",
    "theme_version": "3.2.0",
    "theme_author": "LINUX",
    "theme_documentation_url": "https://linux-eg.com",
    "theme_support_url": "https://wa.me/201110351549"
  },
  {
    "name": "Appearance",
    "settings": [
      {
        "type": "select",
        "id": "color_scheme",
        "label": "Scheme",
        "options": [
          {
            "value": "forest",
            "label": "Forest (dark)"
          },
          {
            "value": "cream",
            "label": "Cream (light)"
          }
        ],
        "default": "forest"
      },
      {
        "type": "header",
        "content": "Brand colours"
      },
      {
        "type": "paragraph",
        "content": "Leave a colour empty to keep the LINUX default (forest / cream / lime). Changing these recolours the whole theme: glass, buttons, badges, links."
      },
      {
        "type": "color",
        "id": "brand_forest",
        "label": "Forest (dark base)"
      },
      {
        "type": "color",
        "id": "brand_cream",
        "label": "Cream (text on dark)"
      },
      {
        "type": "color",
        "id": "brand_lime",
        "label": "Lime (accent / buttons)"
      },
      {
        "type": "range",
        "id": "glass_strength",
        "label": "Glass blur",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "radius_scale",
        "label": "Corner roundness",
        "min": 60,
        "max": 140,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "motion_scale",
        "label": "Motion",
        "min": 0,
        "max": 100,
        "step": 100,
        "unit": "%",
        "default": 100,
        "info": "0 disables all animation"
      },
      {
        "type": "checkbox",
        "id": "show_curtain",
        "label": "Logo curtain on first visit (home page)",
        "default": true
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1200,
        "max": 1680,
        "step": 40,
        "unit": "px",
        "default": 1440
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social share image"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "checkbox",
        "id": "type_system_fonts",
        "label": "Use system fonts (skip Froople / Mochi Tubby / Thmanyah Sans)",
        "default": false
      },
      {
        "type": "range",
        "id": "type_scale",
        "label": "Text size",
        "min": 85,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Headline size",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & spacing",
    "settings": [
      {
        "type": "range",
        "id": "section_gap",
        "label": "Space between sections",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "gutter_scale",
        "label": "Side padding",
        "min": 50,
        "max": 150,
        "step": 10,
        "unit": "%",
        "default": 100
      },
      {
        "type": "header",
        "content": "Mobile"
      },
      {
        "type": "range",
        "id": "mobile_type_scale",
        "label": "Mobile text size",
        "min": 85,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "show_tab_bar",
        "label": "Bottom tab bar on phones",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "mobile_two_col",
        "label": "Two product columns on phones (off = one wide column)",
        "default": true
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "paragraph",
        "content": "Menus themselves are edited in Online Store → Navigation. Menu titles the theme knows (Shop, Customize, Journal, About, Contact…) are translated automatically."
      },
      {
        "type": "link_list",
        "id": "side_menu",
        "label": "Mobile menu",
        "default": "main-menu"
      },
      {
        "type": "text",
        "id": "search_suggestions",
        "label": "Popular searches (comma separated)",
        "default": "Hoodie,Anime,Customize,Sada,Shirt"
      },
      {
        "type": "checkbox",
        "id": "show_locale_switcher",
        "label": "Show language switcher",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_wishlist",
        "label": "Show wishlist (heart) in header and tab bar",
        "default": true
      }
    ]
  },
  {
    "name": "Cart & checkout",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (LE, 0 to hide meter)",
        "default": 2000
      },
      {
        "type": "checkbox",
        "id": "show_stock_hint",
        "label": "Show \"Only X left\" on product pages",
        "default": true
      },
      {
        "type": "range",
        "id": "low_stock",
        "label": "Low stock threshold",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Order note field in the bag",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_discount",
        "label": "Discount code field in the bag",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_upsell",
        "label": "\"Complete the look\" suggestions in the bag",
        "default": true
      }
    ]
  },
  {
    "name": "Product page",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_size_guide",
        "label": "Show size guide",
        "default": true
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "Size guide page (optional rich content)"
      },
      {
        "type": "checkbox",
        "id": "show_sticky_atc",
        "label": "Sticky add-to-bag bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_recently_viewed",
        "label": "Recently viewed",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_delivery_estimate",
        "label": "Show delivery estimate",
        "default": true
      },
      {
        "type": "text",
        "id": "delivery_cairo",
        "label": "Delivery: Cairo & Giza",
        "default": "1–2 days"
      },
      {
        "type": "text",
        "id": "delivery_egypt",
        "label": "Delivery: rest of Egypt",
        "default": "2–4 days"
      },
      {
        "type": "checkbox",
        "id": "show_embroidered_chip",
        "label": "Show \"Embroidered in Cairo\" chip on product photos",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_share",
        "label": "Show share button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Quick add (size pills) on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_compare",
        "label": "Show crossed-out compare price",
        "default": true
      }
    ]
  },
  {
    "name": "404 page",
    "settings": [
      {
        "type": "paragraph",
        "content": "The 404 page also has its own section in the theme editor (open any missing URL while customizing). These are the defaults."
      },
      {
        "type": "checkbox",
        "id": "show_404_search",
        "label": "Show search box",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_404_products",
        "label": "Show popular products",
        "default": true
      },
      {
        "type": "collection",
        "id": "collection_404",
        "label": "Collection for popular products (blank = all)"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_footer_policies",
        "label": "Show policy links",
        "default": true
      },
      {
        "type": "text",
        "id": "made_in",
        "label": "\"Made in\" line (blank = translated)"
      }
    ]
  },
