        "label": "Floating WhatsApp bubble",
        "options": [
          {
            "value": "customize",
            "label": "Customize page only"
          },
          {
            "value": "everywhere",
            "label": "Every page"
          },
          {
            "value": "none",
            "label": "Hidden"
          }
