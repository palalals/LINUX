{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      <p class="eyebrow">{% if s.number != blank %}<span class="eyebrow__num">{{ s.number }}</span>{% endif %}{% render 'tr', value: s.eyebrow, key: 'home.look_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.look_heading' %}</h2>
    </div>
  </div>
  <div class="look-grid">
    <div class="look glass" data-reveal>
      {%- if s.image != blank -%}
        <img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.heading | escape }}" width="1200" height="1500" loading="lazy">
      {%- else -%}
        <img src="{{ 'brand-lookbook-1.webp' | asset_url }}" alt="" width="1000" height="1334" loading="lazy">
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <button class="hotspot" type="button" data-hotspot style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%" aria-label="{{ p.title | escape }}" {{ block.shopify_attributes }}></button>
          <a class="hotspot__card glass glass--solid" href="{{ p.url }}" style="left: min(max({{ block.settings.x }}%, 6%), 60%); top: calc({{ block.settings.y }}% + 22px)">
            {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 160 }}" alt="" width="60" height="74">{%- endif -%}
            <span><strong>{% render 'product-title', title: p.title %}</strong><span>{% render 'money', amount: p.price %}</span></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="look-grid__side">
      <p class="lede" data-reveal>{% render 'tr', value: s.body, key: 'home.look_body' %}</p>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <div class="look-item glass glass--hover" data-reveal style="--i: {{ forloop.index }}">
            <a href="{{ p.url }}">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 200 }}" alt="" width="84" height="104" loading="lazy">{%- endif -%}</a>
            <div><a href="{{ p.url }}"><strong>{% render 'product-title', title: p.title %}</strong></a>{% render 'price', product: p %}</div>
            {%- if p.available -%}
              {%- if p.has_only_default_variant -%}
                <button class="btn btn--cream btn--sm" type="button" data-quick-add="{{ p.first_available_variant.id }}">{% render 'icon', name: 'plus', px: 16 %}</button>
              {%- else -%}
                <button class="btn btn--cream btn--sm" type="button" data-quick-view="{{ p.handle }}">{{ 'products.choose_size' | t }}</button>
              {%- endif -%}
            {%- else -%}
              <span class="chip chip--soldout">{{ 'products.sold_out' | t }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="muted">{{ 'sections.look.empty' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop the look",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Section number",
      "default": "04"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text (blank = translated)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Look image"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        {
          "type": "hotspot"
        },
        {
          "type": "hotspot"
        }
      ]
    }
  ]
}
{% endschema %}
