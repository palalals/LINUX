<section class="account wrap">
  <div class="auth">
    <div class="auth__mascot" data-reveal>{% render 'mascot', name: 'classic', width: 120 %}</div>
    <div class="auth__panel glass" data-reveal style="--i:1">
      <div id="login" data-auth-login>
        <p class="eyebrow">{{ shop.name }}</p>
        <h1>{{ 'customer.login.title' | t }}</h1>
        {%- form 'customer_login', novalidate: 'novalidate' -%}
          {{ form.errors | default_errors }}
          <label class="field"><span class="field__label">{{ 'customer.login.email' | t }}</span><input class="input" type="email" name="customer[email]" autocomplete="email" required></label>
          <label class="field"><span class="field__label">{{ 'customer.login.password' | t }}</span><input class="input" type="password" name="customer[password]" autocomplete="current-password" required></label>
          <button class="btn btn--primary btn--lg btn--block" type="submit">{{ 'customer.login.submit' | t }}</button>
          <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap">
            <a class="link small" href="#recover" data-auth-toggle="recover">{{ 'customer.login.forgot' | t }}</a>
            <span class="small muted">{{ 'customer.login.no_account' | t }} <a class="link" href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a></span>
          </div>
        {%- endform -%}
      </div>
      <div id="recover" data-auth-recover hidden>
        <p class="eyebrow">{{ shop.name }}</p>
        <h1>{{ 'customer.login.recover_title' | t }}</h1>
        <p class="muted small">{{ 'customer.login.recover_body' | t }}</p>
        {%- form 'recover_customer_password' -%}
          {%- if form.posted_successfully? -%}<p class="form-success">{{ 'customer.login.recover_success' | t }}</p>{%- endif -%}
          {{ form.errors | default_errors }}
          <label class="field"><span class="field__label">{{ 'customer.login.email' | t }}</span><input class="input" type="email" name="email" autocomplete="email" required></label>
          <button class="btn btn--primary btn--lg btn--block" type="submit">{{ 'customer.login.recover_submit' | t }}</button>
          <a class="link small" href="#login" data-auth-toggle="login">{{ 'customer.login.cancel' | t }}</a>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
<script>
  (function () {
    var login = document.querySelector('[data-auth-login]'), recover = document.querySelector('[data-auth-recover]');
    function show(which) { login.hidden = which === 'recover'; recover.hidden = which !== 'recover'; }
    document.querySelectorAll('[data-auth-toggle]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); show(a.dataset.authToggle); history.replaceState(null, '', '#' + a.dataset.authToggle); }); });
    if (location.hash === '#recover') show('recover');
  })();
</script>
{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
