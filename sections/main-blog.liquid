<section class="blog wrap">
  <header class="page__head" data-reveal>
    <p class="eyebrow">{{ 'blog.back' | t }}</p>
    <h1>{% render 'menu-title', title: blog.title %}</h1>
  </header>
  {%- paginate blog.articles by 9 -%}
    <div class="blog__grid">
      {%- for article in blog.articles -%}
        <article class="post glass glass--hover{% if forloop.first and paginate.current_page == 1 %} post--featured{% endif %}" data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
          <a class="post__media media media__zoom" href="{{ article.url }}" tabindex="-1">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="1000" height="625">{%- else -%}<img src="{{ 'brand-still-life.webp' | asset_url }}" alt="" width="1400" height="875" loading="lazy">{%- endif -%}
          </a>
          <div class="post__body">
            <p class="post__meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{% render 'date-ar', date: article.published_at %}</time>{%- if article.tags.size > 0 -%} · {% for tg in article.tags %}{% render 'option-value', value: tg %}{% unless forloop.last %} · {% endunless %}{% endfor %}{%- endif -%}</p>
            <h2 class="post__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            <span class="btn btn--ghost btn--sm" style="justify-self:start">{{ 'blog.read_more' | t }}{% render 'icon', name: 'arrow-right', px: 16 %}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
