{%- assign s = section.settings -%}
<section class="page wrap">
  <div class="about-hero glass" data-reveal>
    <div class="media media__zoom">
      {%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 1200 }}" alt="{{ s.image.alt | escape }}" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="eager">{%- else -%}<img src="{{ 'brand-editorial.webp' | asset_url }}" alt="" width="1400" height="788" loading="eager">{%- endif -%}
    </div>
    <div style="display:grid;gap:16px">
      <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'home.about_eyebrow' %}</p>
      <h1 class="display" style="font-size:clamp(34px,4.6vw,66px)">{% render 'tr', value: s.heading, key: 'home.about_heading' %}</h1>
      <div class="rte">{%- capture fb -%}<p>{{ 'home.about_body' | t }}</p>{%- endcapture -%}{%- if s.intro != blank -%}{% render 'localized-content', content: s.intro, fallback: fb %}{%- elsif page.content != blank -%}{% render 'localized-content', content: page.content, fallback: fb %}{%- else -%}{{ fb }}{%- endif -%}</div>
    </div>
  </div>
  <div class="about-stats">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="about-stat glass" data-reveal="scale" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}><strong data-count>{% render 'tr', value: block.settings.value, key: block.settings.key_value %}</strong><span>{% render 'tr', value: block.settings.label, key: block.settings.key_label %}</span></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="timeline">
    {%- for block in section.blocks -%}
      {%- if block.type == 'moment' -%}
        <div class="timeline__item glass" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}><span class="mono">{% render 'tr', value: block.settings.year, key: block.settings.key_year %}</span><div><strong>{% render 'tr', value: block.settings.title, key: block.settings.key_title %}</strong><p class="muted small" style="margin-top:4px">{% render 'tr', value: block.settings.text, key: block.settings.key_text %}</p></div></div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "About story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "key_value",
          "label": "Translation key — value (optional)"
        },
        {
          "type": "text",
          "id": "key_label",
          "label": "Translation key — label (optional)"
        }
      ]
    },
    {
      "type": "moment",
      "name": "Timeline moment",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "key_year",
          "label": "Translation key — year (optional)"
        },
        {
          "type": "text",
          "id": "key_title",
          "label": "Translation key — title (optional)"
        },
        {
          "type": "text",
          "id": "key_text",
          "label": "Translation key — text (optional)"
        }
      ]
    }
  ]
}
{% endschema %}
