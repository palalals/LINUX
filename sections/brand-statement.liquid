{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="statement glass" data-reveal>
    <span class="statement__stitch" aria-hidden="true"></span>
    <p class="eyebrow">{%- assign k_eyebrow = s.key_eyebrow | default: 'home.statement_eyebrow' -%}{%- assign k_heading = s.key_heading | default: 'home.statement_heading_html' -%}{%- assign k_body = s.key_body | default: 'home.statement_body' -%}{%- assign k_cta = s.key_cta | default: 'home.statement_cta' -%}{% render 'tr', value: s.eyebrow, key: k_eyebrow %}</p>
    <h2 class="statement__quote">{% render 'tr', value: s.heading, key: k_heading %}</h2>
    <p class="lede" style="text-align:center">{% render 'tr', value: s.body, key: k_body %}</p>
    {%- if s.show_mascots -%}
      <div class="statement__mascots" aria-hidden="true">
        {% render 'mascot', name: 'classic', width: 110 %}
        {% render 'mascot', name: 'skate-spray', width: 110 %}
        {% render 'mascot', name: 'boombox', width: 110 %}
      </div>
    {%- endif -%}
    <a href="{%- if s.cta_url != blank -%}{{ s.cta_url }}{%- else -%}{{ pages['about'].url | default: routes.root_url }}{%- endif -%}" class="btn btn--glass">{% render 'tr', value: s.cta_label, key: k_cta %}{% render 'icon', name: 'arrow-up-right', px: 16 %}</a>
    <span class="statement__stitch statement__stitch--bottom" aria-hidden="true"></span>
  </div>
</section>
{% schema %}
{
  "name": "Brand statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text (blank = translated)"
    },
    {
      "type": "checkbox",
      "id": "show_mascots",
      "label": "Show penguins",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button (blank = translated)"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "key_eyebrow",
      "label": "Translation key — eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "key_heading",
      "label": "Translation key — heading (optional)"
    },
    {
      "type": "text",
      "id": "key_body",
      "label": "Translation key — body (optional)"
    },
    {
      "type": "text",
      "id": "key_cta",
      "label": "Translation key — button (optional)"
    }
  ],
  "presets": [
    {
      "name": "Brand statement"
    }
  ]
}
{% endschema %}
