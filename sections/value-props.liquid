<section class="section wrap" id="s-{{ section.id }}">
  <div class="props">
    {%- for block in section.blocks -%}
      <div class="prop glass glass--hover" data-tilt data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <span class="prop__icon">{% render 'icon', name: block.settings.icon, px: 22 %}</span>
        <strong>{% render 'tr', value: block.settings.title, key: block.settings.key_title %}</strong>
        <span>{% render 'tr', value: block.settings.text, key: block.settings.key_text %}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Value props",
  "blocks": [
    {
      "type": "prop",
      "name": "Prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "needle",
              "label": "Needle"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "key_title",
          "label": "Translation key — title (optional)"
        },
        {
          "type": "text",
          "id": "key_text",
          "label": "Translation key — text (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        {
          "type": "prop"
        },
        {
          "type": "prop"
        },
        {
          "type": "prop"
        },
        {
          "type": "prop"
        }
      ]
    }
  ]
}
{% endschema %}
