{%- if settings.show_recently_viewed -%}
<section class="section wrap" id="s-{{ section.id }}" data-recently-viewed hidden>
  <div class="section-head">
    <div class="section-head__text"><p class="eyebrow">{{ 'products.recently_viewed' | t }}</p><h2>{% render 'tr', value: section.settings.heading, key: 'products.recently_viewed' %}</h2></div>
  </div>
  <div class="rail" data-rail>
    <div class="rail__track" data-recently-viewed-track></div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ]
}
{% endschema %}
