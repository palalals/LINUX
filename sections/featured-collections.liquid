{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      <p class="eyebrow">{% if s.number != blank %}<span class="eyebrow__num">{{ s.number }}</span>{% endif %}{% render 'tr', value: s.eyebrow, key: 'home.collections_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.collections_heading' %}</h2>
    </div>
    <a href="{{ routes.collections_url }}" class="btn btn--ghost btn--sm" data-reveal>{{ 'general.view_all' | t }}</a>
  </div>
  <div class="bento">
    {%- for block in section.blocks -%}
      {%- liquid
        assign bs = block.settings
        assign coll = bs.collection
        assign img = bs.image
        if img == blank and coll.image
          assign img = coll.image
        endif
        if img == blank and coll.products.first.featured_image
          assign img = coll.products.first.featured_image
        endif
        assign url = coll.url | default: routes.all_products_collection_url
        capture label
          render 'tr', value: bs.label, key: bs.key_label
        endcapture
        assign label = label | strip
        if label == blank
          capture label
            render 'menu-title', title: coll.title
          endcapture
          assign label = label | strip
        endif
        capture sub
          render 'tr', value: bs.sub, key: bs.key_sub
        endcapture
        assign sub = sub | strip
      -%}
      {%- liquid
        assign has_photo = false
        if img != blank
          assign has_photo = true
        endif
        if coll.handle == 'customize-print' and bs.image == blank
          assign has_photo = false
        endif
      -%}
      <a href="{{ url }}" data-tilt class="bento__tile bento__tile--{{ bs.size | default: 'small' }}{% unless has_photo %} bento__tile--empty{% endunless %}" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if has_photo -%}
          <img src="{{ img | image_url: width: 800 }}" srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w" sizes="(max-width: 900px) 50vw, 25vw" alt="" width="800" height="800" loading="lazy" decoding="async">
        {%- else -%}
          {%- assign tile_mascot = bs.mascot | default: 'skate-spray' -%}
          {% render 'mascot', name: tile_mascot, width: 150, class: 'bento__mascot' %}
        {%- endif -%}
        <span class="bento__label glass glass--solid">
          <span><strong>{{ label }}</strong>{% if coll.products_count %}<small>{{ 'collections.count' | t: count: coll.products_count }}</small>{% elsif sub != blank %}<small>{{ sub }}</small>{% endif %}</span>
          <span class="bento__arrow">{% render 'icon', name: 'arrow-right', px: 18 %}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Section number",
      "default": "02"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override"
        },
        {
          "type": "text",
          "id": "sub",
          "label": "Sub label"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "wide",
              "label": "Wide"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "small"
        },
        {
          "type": "text",
          "id": "key_label",
          "label": "Translation key — label (optional)"
        },
        {
          "type": "text",
          "id": "key_sub",
          "label": "Translation key — subtitle (optional)"
        },
        {
          "type": "select",
          "id": "mascot",
          "label": "Penguin shown when the collection has no photo",
          "options": [
            { "value": "skate-spray", "label": "Spray can" },
            { "value": "classic", "label": "Classic" },
            { "value": "skate", "label": "Skate" },
            { "value": "hoodie-sit", "label": "Hoodie, sitting" },
            { "value": "boombox", "label": "Boombox" }
          ],
          "default": "skate-spray"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
