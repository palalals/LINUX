{%- assign is_wishlist = false -%}
{%- if template.suffix == 'wishlist' or request.query.view == 'wishlist' or search.terms == 'wishlist' -%}
  {%- assign is_wishlist = true -%}
{%- endif -%}
<section class="search-page wrap" id="search-{{ section.id }}" data-search-page>
  <div class="search-page__wishlist" data-search-wishlist-section{% unless is_wishlist %} hidden{% endunless %}>
    <header class="collection__head glass" data-reveal>
      <div><p class="eyebrow">{% render 'icon', name: 'heart', px: 12 %} {{ 'wishlist.title' | t }}</p><h1 class="collection__title">{{ 'wishlist.title' | t }}</h1></div>
    </header>
    <div class="product-grid" style="--cols: 4" data-wishlist-grid></div>
    <div class="empty-state glass" data-wishlist-empty hidden>
      {% render 'mascot', name: 'classic', width: 140 %}
      <h2>{{ 'wishlist.empty_title' | t }}</h2>
      <p class="muted">{{ 'wishlist.empty_body' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.start_shopping' | t }}</a>
    </div>
  </div>

  <div class="search-page__normal" data-search-normal-section{% if is_wishlist %} hidden{% endif %}>
    <header data-reveal>
      <p class="eyebrow">{{ 'search.title' | t }}</p>
      <h1 class="collection__title">{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
      <form class="search-page__form glass glass--pill" action="{{ routes.search_url }}" method="get" role="search">
        <input class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.title' | t }}">
        <input type="hidden" name="type" value="product">
        <button class="btn btn--primary" type="submit">{% render 'icon', name: 'search', px: 18 %}{{ 'search.title' | t }}</button>
      </form>
      {%- if search.performed -%}<p class="mono muted">{{ 'search.results_count' | t: count: search.results_count }}</p>{%- endif -%}
    </header>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <div class="product-grid" style="--cols: 4; margin-top: 24px">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' or item.variants -%}
                {% render 'product-card', product: item, index: forloop.index0 %}
              {%- else -%}
                <a href="{{ item.url }}" class="card glass glass--hover" style="padding:20px"><p class="eyebrow">{{ item.object_type | default: 'Page' }}</p><h3>{{ item.title }}</h3></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- else -%}
          <div class="empty-state glass" style="margin-top:24px">
            {% render 'mascot', name: 'classic', width: 150 %}
            <h2>{{ 'search.empty_title' | t }}</h2>
            <p class="muted">{{ 'search.empty_body' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.start_shopping' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
  <script>
    (function() {
      try {
        if (new URLSearchParams(window.location.search).get('view') === 'wishlist') {
          var wl = document.querySelector('[data-search-wishlist-section]');
          var norm = document.querySelector('[data-search-normal-section]');
          if (wl && norm) {
            wl.hidden = false;
            norm.hidden = true;
          }
        }
      } catch (e) {}
    })();
  </script>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
