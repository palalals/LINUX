{%- comment -%}
  Customize studio v4 — two independent designs (front + back) on real garment
  photos. Each side keeps its own artwork, position, scale and rotation; the
  side tabs on the stage switch between them and show a dot when a side has a
  design. Quantity with a size per piece, print vs embroidery rules, notes.

  Order payload (line-item properties on the merchant's Customize product):
    Front design / Back design   the original artwork files (multipart)
    Front mockup / Back mockup   composited JPEGs of the garment WITH the design
    Front position / Back position  "x:50,y:42,scale:42,rotate:0"
    Sides                        "Front + Back" | "Front" | "Back"
    Garment / Colour / Method / Sizes / Notes
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
  if p == blank
    assign p = all_products['hoodie-customize']
  endif
  if p == blank
    assign p = collections.all.products.first
  endif
  assign current = p.selected_or_first_available_variant
  assign min_emb = s.min_embroidery | default: 10
  assign sizes = s.sizes | default: 'S,M,L,XL,2XL' | split: ','
  assign wa = settings.whatsapp_number | remove: '+' | remove: ' '
  assign default_side = s.default_side | default: 'back'
  assign default_garment = s.default_garment | default: 'hoodie'
  assign color_blocks = section.blocks | where: 'type', 'color'
  assign max_mb = s.max_mb | default: 10
-%}
<section class="cz wrap" data-customize data-product-handle="{{ p.handle }}" data-min-embroidery="{{ min_emb }}" data-max-qty="{{ s.max_qty | default: 50 }}" data-max-mb="{{ max_mb }}" data-shape="{{ default_garment }}" data-side="{{ default_side }}">
  <header class="cz__head" data-reveal>
    <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'home.customize_eyebrow' %}</p>
    <h1 class="display" data-split>{% render 'tr', value: s.heading, key: 'home.customize_heading' %}</h1>
    <p class="lede">{% render 'tr', value: s.subheading, key: 'customize.subtitle' %}</p>
  </header>

  <div class="cz__grid">
    {%- comment -%} ---------- Stage ---------- {%- endcomment -%}
    <div class="cz__stage glass" data-specular data-reveal>
      <div class="cz__stage-top">
        {%- if s.show_tee -%}
        <div class="segmented" role="radiogroup" aria-label="{{ 'customize.garment' | t }}">
          <button class="segmented__btn{% if default_garment == 'hoodie' %} is-active{% endif %}" type="button" data-cz-garment-opt="hoodie" data-label="{{ 'home.garment_hoodie' | t | escape }}" aria-pressed="{% if default_garment == 'hoodie' %}true{% else %}false{% endif %}">{% render 'icon', name: 'hoodie', px: 16 %}{{ 'home.garment_hoodie' | t }}</button>
          <button class="segmented__btn{% if default_garment == 'tee' %} is-active{% endif %}" type="button" data-cz-garment-opt="tee" data-label="{{ 'home.garment_tee' | t | escape }}" aria-pressed="{% if default_garment == 'tee' %}true{% else %}false{% endif %}">{% render 'icon', name: 'shirt', px: 16 %}{{ 'home.garment_tee' | t }}</button>
        </div>
        {%- else -%}
        <input type="hidden" data-cz-garment-opt="hoodie" data-label="{{ 'home.garment_hoodie' | t | escape }}" class="is-active">
        {%- endif -%}
        <div class="segmented cz__sides" role="tablist" aria-label="{{ 'customize.side' | t }}">
          <button class="segmented__btn{% if default_side == 'front' %} is-active{% endif %}" type="button" role="tab" data-cz-side="front" aria-selected="{% if default_side == 'front' %}true{% else %}false{% endif %}">{{ 'customize.front' | t }}<span class="cz__side-dot" data-cz-side-dot="front" hidden></span></button>
          <button class="segmented__btn{% if default_side == 'back' %} is-active{% endif %}" type="button" role="tab" data-cz-side="back" aria-selected="{% if default_side == 'back' %}true{% else %}false{% endif %}">{{ 'customize.back' | t }}<span class="cz__side-dot" data-cz-side-dot="back" hidden></span></button>
        </div>
      </div>

      <div class="cz__canvas" data-cz-canvas>
        <div class="cz__garment" data-cz-garment>
          {%- for block in color_blocks -%}
            {%- assign b = block.settings -%}
            {%- assign key = block.id -%}
            {%- if b.hoodie_back != blank -%}<img class="cz__photo" data-cz-photo="{{ key }}|hoodie-back" src="{{ b.hoodie_back | image_url: width: 1000 }}" alt="" width="1000" height="1000" loading="lazy" decoding="async" hidden>
            {%- elsif b.builtin != blank and b.builtin != 'none' -%}<img class="cz__photo" data-cz-photo="{{ key }}|hoodie-back" src="{{ 'cz-hoodie-back-' | append: b.builtin | append: '.webp' | asset_url }}" alt="" width="720" height="720" loading="lazy" decoding="async" hidden>{%- endif -%}
            {%- if b.hoodie_front != blank -%}<img class="cz__photo" data-cz-photo="{{ key }}|hoodie-front" src="{{ b.hoodie_front | image_url: width: 1000 }}" alt="" width="1000" height="1000" loading="lazy" decoding="async" hidden>{%- endif -%}
            {%- if b.tee_front != blank -%}<img class="cz__photo" data-cz-photo="{{ key }}|tee-front" src="{{ b.tee_front | image_url: width: 1000 }}" alt="" width="1000" height="1000" loading="lazy" decoding="async" hidden>{%- endif -%}
            {%- if b.tee_back != blank -%}<img class="cz__photo" data-cz-photo="{{ key }}|tee-back" src="{{ b.tee_back | image_url: width: 1000 }}" alt="" width="1000" height="1000" loading="lazy" decoding="async" hidden>{%- endif -%}
          {%- endfor -%}
          <div class="cz__mock" data-cz-mock="hoodie-front" hidden>{% render 'garment-mockup', shape: 'hoodie', side: 'front' %}</div>
          <div class="cz__mock" data-cz-mock="hoodie-back" hidden>{% render 'garment-mockup', shape: 'hoodie', side: 'back' %}</div>
          <div class="cz__mock" data-cz-mock="tee-front" hidden>{% render 'garment-mockup', shape: 'tee', side: 'front' %}</div>
          <div class="cz__mock" data-cz-mock="tee-back" hidden>{% render 'garment-mockup', shape: 'tee', side: 'back' %}</div>

          <div class="cz__print-area" data-cz-area aria-hidden="true"></div>

          {%- if default_side == 'front' -%}{%- assign default_side_label = 'customize.front' | t -%}{%- else -%}{%- assign default_side_label = 'customize.back' | t -%}{%- endif -%}
          <button class="cz__empty glass" type="button" data-cz-pick>{% render 'icon', name: 'upload', px: 22 %}<span data-cz-empty-label>{{ 'customize.upload_side' | t: side: default_side_label }}</span><small>{{ 'customize.drop_hint' | t }}</small></button>

          {%- assign side_list = 'front,back' | split: ',' -%}
          {%- for side in side_list -%}
          <div class="cz__design" data-cz-design="{{ side }}" hidden tabindex="0" role="img" aria-label="{{ 'customize.preview_alt' | t }}">
            <img alt="" width="400" height="400" data-cz-design-img draggable="false">
            <span class="cz__frame" aria-hidden="true"></span>
            <button class="cz__knob cz__knob--scale" type="button" data-cz-knob="scale" aria-label="{{ 'customize.scale' | t }}">{% render 'icon', name: 'move', px: 12 %}</button>
            <button class="cz__knob cz__knob--rotate" type="button" data-cz-knob="rotate" aria-label="{{ 'customize.rotate' | t }}">{% render 'icon', name: 'rotate', px: 12 %}</button>
          </div>
          {%- endfor -%}
        </div>

        <div class="cz__tools glass glass--solid" data-cz-tools hidden>
          <button class="icon-btn" type="button" data-cz-tool="zoom-out" aria-label="{{ 'customize.smaller' | t }}" title="{{ 'customize.smaller' | t }}">{% render 'icon', name: 'minus', px: 16 %}</button>
          <button class="icon-btn" type="button" data-cz-tool="zoom-in" aria-label="{{ 'customize.bigger' | t }}" title="{{ 'customize.bigger' | t }}">{% render 'icon', name: 'plus', px: 16 %}</button>
          <span class="cz__tools-sep"></span>
          <button class="icon-btn" type="button" data-cz-tool="rotate-l" aria-label="{{ 'customize.rotate_left' | t }}" title="{{ 'customize.rotate_left' | t }}">{% render 'icon', name: 'rotate-left', px: 16 %}</button>
          <button class="icon-btn" type="button" data-cz-tool="rotate-r" aria-label="{{ 'customize.rotate_right' | t }}" title="{{ 'customize.rotate_right' | t }}">{% render 'icon', name: 'rotate', px: 16 %}</button>
          <span class="cz__tools-sep"></span>
          <button class="icon-btn" type="button" data-cz-tool="center" aria-label="{{ 'customize.center' | t }}" title="{{ 'customize.center' | t }}">{% render 'icon', name: 'target', px: 16 %}</button>
          <button class="icon-btn" type="button" data-cz-tool="fit" aria-label="{{ 'customize.fit' | t }}" title="{{ 'customize.fit' | t }}">{% render 'icon', name: 'maximize', px: 16 %}</button>
          <span class="cz__tools-sep"></span>
          <button class="icon-btn" type="button" data-cz-tool="replace" aria-label="{{ 'customize.replace' | t }}" title="{{ 'customize.replace' | t }}">{% render 'icon', name: 'upload', px: 16 %}</button>
          <button class="icon-btn" type="button" data-cz-tool="remove" aria-label="{{ 'customize.remove' | t }}" title="{{ 'customize.remove' | t }}">{% render 'icon', name: 'trash', px: 16 %}</button>
        </div>
      </div>

      <div class="cz__stage-foot">
        <div class="cz__colors" role="radiogroup" aria-label="{{ 'customize.color' | t }}">
          {%- for block in color_blocks -%}
            {%- assign b = block.settings -%}
            {%- capture c_label -%}{% render 'option-value', value: b.name %}{%- endcapture -%}{%- assign c_label = c_label | strip -%}
            <button class="pill swatch{% if forloop.first %} is-active{% endif %}" type="button" style="--swatch: {{ b.hex }}" data-cz-color="{{ block.id }}" data-cz-hex="{{ b.hex }}" data-cz-color-name="{{ b.name | escape }}" data-cz-variant-value="{{ b.variant_value | default: b.name | escape }}" aria-label="{{ c_label | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" title="{{ c_label | escape }}" {{ block.shopify_attributes }}></button>
          {%- endfor -%}
          <span class="cz__color-name" data-cz-color-label>{% render 'option-value', value: color_blocks.first.settings.name %}</span>
        </div>
        <p class="cz__hint">{% render 'icon', name: 'move', px: 14 %}<span data-cz-hint>{{ 'customize.hint_3d' | t }}</span></p>
      </div>
    </div>

    {%- comment -%} ---------- Panel ---------- {%- endcomment -%}
    {%- form 'product', p, class: 'cz__panel glass', data-product-form: '', data-cz-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <input type="hidden" name="quantity" value="1" data-cz-qty-field>
      <input type="hidden" name="properties[Garment]" data-cz-garment-prop value="{{ 'home.garment_hoodie' | t | escape }}">
      <input type="hidden" name="properties[Colour]" data-cz-color-prop value="{{ color_blocks.first.settings.name | escape }}">
      <input type="hidden" name="properties[Method]" data-cz-method-prop value="Print">
      <input type="hidden" name="properties[Sides]" data-cz-sides-prop value="">
      <input type="hidden" name="properties[Sizes]" data-cz-sizes-prop value="">
      <input type="hidden" name="properties[Front position]" data-cz-pos="front" value="" disabled>
      <input type="hidden" name="properties[Back position]" data-cz-pos="back" value="" disabled>
      <input type="file" name="properties[Front mockup]" accept="image/jpeg" class="visually-hidden" tabindex="-1" aria-hidden="true" data-cz-mockup="front">
      <input type="file" name="properties[Back mockup]" accept="image/jpeg" class="visually-hidden" tabindex="-1" aria-hidden="true" data-cz-mockup="back">

      {%- comment -%} Step 1: one card per side {%- endcomment -%}
      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">1</span>{{ 'customize.designs' | t }}<small class="cz__step-note">{{ 'customize.designs_note' | t }}</small></p>
        <div class="cz__uploads">
          {%- assign side_list = 'front,back' | split: ',' -%}
          {%- for side in side_list -%}
            {%- if side == 'front' -%}{%- assign side_label = 'customize.front' | t -%}{%- else -%}{%- assign side_label = 'customize.back' | t -%}{%- endif -%}
            <div class="cz__upload" data-cz-upload="{{ side }}">
              <label class="cz__drop" data-cz-drop="{{ side }}">
                <span class="cz__drop-side">{{ side_label }}</span>
                {% render 'icon', name: 'upload', px: 22 %}
                <strong>{{ 'customize.upload_side' | t: side: side_label }}</strong>
                <small>{{ 'customize.upload_hint' | t: mb: max_mb }}</small>
                <input type="file" name="properties[{{ side | capitalize }} design]" accept="image/png,image/jpeg,image/svg+xml,image/webp" class="visually-hidden" data-cz-file="{{ side }}">
              </label>
              <div class="cz__file glass glass--clear" data-cz-file-row="{{ side }}" hidden>
                <img alt="" width="44" height="44" data-cz-thumb>
                <div class="cz__file-meta"><span class="cz__drop-side">{{ side_label }}</span><strong data-cz-filename></strong><small class="muted" data-cz-filesize></small></div>
                <div class="cz__file-actions">
                  <button class="icon-btn" type="button" data-cz-edit="{{ side }}" aria-label="{{ 'customize.edit_side' | t: side: side_label }}" title="{{ 'customize.edit_side' | t: side: side_label }}">{% render 'icon', name: 'move', px: 16 %}</button>
                  <button class="icon-btn" type="button" data-cz-remove="{{ side }}" aria-label="{{ 'customize.remove' | t }}" title="{{ 'customize.remove' | t }}">{% render 'icon', name: 'trash', px: 16 %}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <p class="form-error" data-cz-error hidden></p>
      </div>

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">2</span>{{ 'customize.method' | t }}</p>
        <div class="cz__methods" role="radiogroup">
          <button class="cz__method is-active" type="button" data-cz-method="Print" data-min="1" aria-pressed="true">
            <span class="cz__method-icon">{% render 'icon', name: 'layers', px: 18 %}</span>
            <strong>{{ 'customize.method_print' | t }}</strong>
            <small>{{ 'customize.print_note' | t }}</small>
          </button>
          <button class="cz__method" type="button" data-cz-method="Embroidery" data-min="{{ min_emb }}" aria-pressed="false">
            <span class="cz__method-icon">{% render 'icon', name: 'needle', px: 18 %}</span>
            <strong>{{ 'customize.method_embroidery' | t }}</strong>
            <small>{{ 'customize.min_embroidery_short' | t: count: min_emb }}</small>
          </button>
        </div>
        <p class="cz__notice glass glass--clear" data-cz-min-notice hidden>{% render 'icon', name: 'info', px: 16 %}<span>{{ 'customize.min_embroidery' | t: count: min_emb }}</span></p>
      </div>

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">3</span>{{ 'customize.quantity' | t }}</p>
        <div class="cz__qty-row">
          <div class="qty">
            <button class="qty__btn" type="button" data-cz-qty-step="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <input class="qty__input" type="number" inputmode="numeric" min="1" value="1" data-cz-qty aria-label="{{ 'customize.quantity' | t }}">
            <button class="qty__btn" type="button" data-cz-qty-step="1" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
          <div class="cz__qty-quick">
            {%- assign quick_qtys = s.quick_qtys | default: '1,5,10,20' | split: ',' -%}{%- for qq in quick_qtys -%}<button class="chip" type="button" data-cz-qty-set="{{ qq | strip }}">{{ qq | strip }}</button>{%- endfor -%}
          </div>
        </div>
        <div class="cz__sizes" data-cz-sizes>
          <p class="cz__sizes-title">{{ 'customize.sizes_title' | t }}</p>
          <div class="cz__sizes-list" data-cz-sizes-list></div>
        </div>
        <template data-cz-size-row>
          <div class="cz__size-row">
            <span class="cz__size-n"></span>
            <div class="pills pills--compact">
              {%- for sz in sizes -%}<label class="pill"><input type="radio" value="{{ sz | strip | escape }}"{% if forloop.index == 2 %} checked{% endif %}>{{ sz | strip }}</label>{%- endfor -%}
            </div>
          </div>
        </template>
      </div>

      <details class="cz__step cz__fine" data-cz-fine>
        <summary class="cz__step-title"><span class="badge">4</span>{{ 'customize.position' | t }}<span class="cz__fine-side" data-cz-fine-side></span>{% render 'icon', name: 'chevron-down', px: 16 %}</summary>
        <div class="cz__fine-body">
          <label class="field"><span class="field__label">{{ 'customize.scale' | t }} <output data-cz-scale-out>42%</output></span><input class="cz__range" type="range" min="10" max="90" value="42" data-cz-scale></label>
          <label class="field"><span class="field__label">{{ 'customize.rotate' | t }} <output data-cz-rotate-out>0°</output></span><input class="cz__range" type="range" min="-180" max="180" value="0" step="1" data-cz-rotate></label>
          <div class="cz__row">
            <button class="btn btn--ghost btn--sm" type="button" data-cz-tool="center">{% render 'icon', name: 'target', px: 14 %}{{ 'customize.center' | t }}</button>
            <button class="btn btn--ghost btn--sm" type="button" data-cz-tool="reset">{% render 'icon', name: 'undo', px: 14 %}{{ 'customize.reset' | t }}</button>
            <button class="btn btn--ghost btn--sm" type="button" data-cz-tool="fit">{% render 'icon', name: 'maximize', px: 14 %}{{ 'customize.fit' | t }}</button>
          </div>
          <p class="cz__keys muted small">{{ 'customize.keys_hint' | t }}</p>
        </div>
      </details>

      <div class="cz__step">
        <p class="cz__step-title"><span class="badge">5</span>{{ 'customize.notes' | t }}</p>
        <textarea class="textarea" name="properties[Notes]" rows="2" placeholder="{{ 'customize.notes_placeholder' | t }}" data-cz-notes></textarea>
      </div>

      <div class="cz__total">
        <div>
          <small>{{ 'customize.total' | t }}</small>
          <strong data-cz-total>{% render 'money', amount: current.price %}</strong>
          <span class="cz__breakdown muted" data-cz-breakdown></span>
        </div>
        <div class="pdp__stock" data-stock><span class="dot"></span><span data-cz-eta>{{ 'customize.eta_print' | t }}</span></div>
      </div>
      <button class="btn btn--primary btn--lg btn--block" type="submit" data-atc data-cz-submit><span data-atc-text>{{ 'customize.add' | t }}</span><span class="pdp__atc-price" data-atc-price>{% render 'money', amount: current.price %}</span></button>
      <p class="form-error" data-cz-submit-error hidden></p>

      {%- if s.show_contact -%}
      <div class="cz__contact glass glass--clear">
        <div><strong>{{ 'customize.contact' | t }}</strong><small class="muted">{{ 'customize.contact_body' | t }}</small></div>
        {%- if wa != blank -%}
          <a class="btn btn--glass btn--sm" href="https://wa.me/{{ wa }}?text={{ 'customize.whatsapp_prefill' | t | url_encode }}" target="_blank" rel="noopener" data-cz-wa>{% render 'icon', name: 'whatsapp', px: 16 %}{{ 'general.whatsapp' | t }}</a>
        {%- else -%}
          <a class="btn btn--glass btn--sm" href="{{ pages['contact'].url | default: routes.root_url }}">{% render 'icon', name: 'message', px: 16 %}{{ 'contact.title' | t }}</a>
        {%- endif -%}
      </div>
      {%- endif -%}
    {%- endform -%}
  </div>

  {%- if s.show_steps -%}
  <div class="cz__steps">
    <div class="prop glass" data-reveal><span class="prop__icon">{% render 'icon', name: 'upload', px: 20 %}</span><strong>{% render 'tr', value: s.step_1, key: 'customize.step_1' %}</strong></div>
    <div class="prop glass" data-reveal style="--i:1"><span class="prop__icon">{% render 'icon', name: 'palette', px: 20 %}</span><strong>{% render 'tr', value: s.step_2, key: 'customize.step_2' %}</strong></div>
    <div class="prop glass" data-reveal style="--i:2"><span class="prop__icon">{% render 'icon', name: 'move', px: 20 %}</span><strong>{% render 'tr', value: s.step_3, key: 'customize.step_3' %}</strong></div>
    <div class="prop glass" data-reveal style="--i:3"><span class="prop__icon">{% render 'icon', name: 'needle', px: 20 %}</span><strong>{% render 'tr', value: s.step_4, key: 'customize.step_4' %}</strong></div>
  </div>
  {%- endif -%}

  <script type="application/json" data-variants>{{ p.variants | json }}</script>
  <script type="application/json" data-product-json>{"id":{{ p.id }},"handle":{{ p.handle | json }},"title":{{ p.title | json }},"url":{{ p.url | json }},"price":{{ current.price }},"strings":{"needDesign":{{ 'customize.need_design' | t | json }},"fileTooBig":{{ 'customize.file_too_big' | t: mb: max_mb | json }},"fileType":{{ 'customize.file_type' | t | json }},"minEmbroidery":{{ 'customize.min_embroidery' | t: count: min_emb | json }},"piece":{{ 'customize.piece' | t: n: '[n]' | json }},"perPiece":{{ 'customize.per_piece' | t: price: '[price]' | json }},"etaPrint":{{ 'customize.eta_print' | t | json }},"etaEmbroidery":{{ 'customize.step_4' | t | json }},"wa":{{ 'customize.whatsapp_prefill' | t | json }},"hint":{{ 'customize.hint_3d' | t | json }},"hintDesign":{{ 'customize.hint_design' | t | json }},"front":{{ 'customize.front' | t | json }},"back":{{ 'customize.back' | t | json }},"uploadSide":{{ 'customize.upload_side' | t: side: '[side]' | json }},"both":{{ 'customize.both_sides' | t | json }},"twoSided":{{ 'customize.two_sided_note' | t | json }}},"methodOption":{{ s.method_option | default: 'Type' | json }},"colorOption":{{ s.color_option | default: 'Color' | json }},"methodValues":{"Print":{{ s.method_print_value | default: 'Print' | json }},"Embroidery":{{ s.method_embroidery_value | default: 'Embroidery' | json }}},"area":{"hoodie":{"front":[50,44,52,50],"back":[50,42,56,58]},"tee":{"front":[50,46,50,50],"back":[50,44,52,54]}}}</script>
</section>
{% schema %}
{
  "name": "Customize studio",
  "settings": [
    { "type": "product", "id": "product", "label": "Customize product", "info": "Its variants carry the price; a 'Type' option with Print / Embroidery values switches the price." },
    { "type": "header", "content": "Copy (blank = translated)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Studio" },
    { "type": "select", "id": "default_garment", "label": "Garment shown first", "options": [ { "value": "hoodie", "label": "Hoodie" }, { "value": "tee", "label": "Tee" } ], "default": "hoodie" },
    { "type": "checkbox", "id": "show_tee", "label": "Offer a tee as well as the hoodie", "default": true },
    { "type": "select", "id": "default_side", "label": "Side shown first", "options": [ { "value": "back", "label": "Back" }, { "value": "front", "label": "Front" } ], "default": "back" },
    { "type": "text", "id": "sizes", "label": "Sizes offered (comma-separated)", "default": "S,M,L,XL,2XL" },
    { "type": "text", "id": "quick_qtys", "label": "Quick quantity chips (comma-separated)", "default": "1,5,10,20" },
    { "type": "range", "id": "min_embroidery", "label": "Minimum pieces for embroidery", "min": 1, "max": 50, "step": 1, "default": 10 },
