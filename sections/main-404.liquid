{%- comment -%}
  404 — a page worth landing on: big glitchy "404" stitched from the brand type,
  the penguin, a search box, quick links, and a rail of popular products so the
  shopper never hits a dead end. Every string is translated (EN/AR) and every
  block is editable in the theme editor.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show_search = s.show_search
  if show_search == nil
    assign show_search = settings.show_404_search
  endif
  assign show_products = s.show_products
  if show_products == nil
    assign show_products = settings.show_404_products
  endif
  assign coll = s.collection
  if coll == blank
    assign coll = settings.collection_404
  endif
  if coll == blank
    assign coll = collections.all
  endif
  assign limit = s.limit | default: 4
  assign suggestions = settings.search_suggestions | default: 'Hoodie,Anime,Customize,Sada,Shirt' | split: ','
  assign labels = 'search.popular_terms' | t | split: ','
-%}
<section class="nf wrap" id="nf-{{ section.id }}">
  <div class="nf__hero glass" data-specular data-reveal>
    <div class="nf__code" aria-hidden="true">
      <span class="nf__digit" style="--d: 0">4</span>
      {%- assign mascot_name = s.mascot | default: 'classic' -%}
      <span class="nf__digit nf__digit--mascot" style="--d: 1">{% render 'mascot', name: mascot_name, width: 220, loading: 'eager' %}</span>
      <span class="nf__digit" style="--d: 2">4</span>
    </div>
    <div class="nf__copy">
      <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'page_404.eyebrow' %}</p>
      <h1 class="nf__title display" data-split>{% render 'tr', value: s.heading, key: 'page_404.title' %}</h1>
      <p class="lede nf__lede">{% render 'tr', value: s.body, key: 'page_404.body' %}</p>

      {%- if show_search -%}
        <form class="nf__search glass glass--pill" action="{{ routes.search_url }}" method="get" role="search">
          {% render 'icon', name: 'search' %}
          <input class="input" type="search" name="q" placeholder="{{ 'page_404.search_placeholder' | t }}" autocomplete="off" aria-label="{{ 'search.title' | t }}">
          <input type="hidden" name="options[prefix]" value="last">
          <button class="btn btn--primary" type="submit">{{ 'search.title' | t }}</button>
        </form>
        <div class="nf__chips">
          {%- for term in suggestions limit: 5 -%}
            {%- assign label = labels[forloop.index0] | default: term -%}
            <a class="chip" href="{{ routes.search_url }}?q={{ term | strip | url_encode }}">{{ label | strip }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="nf__actions">
        <a href="{{ s.cta_url | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg" data-magnetic>{% render 'tr', value: s.cta_label, key: 'page_404.cta' %}{% render 'icon', name: 'arrow-right' %}</a>
        <a href="{{ routes.root_url }}" class="btn btn--glass btn--lg">{{ 'general.back_home' | t }}</a>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="nf__links" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          {%- assign link_href = block.settings.url | default: routes.root_url -%}
          <a class="nf__link glass glass--hover" href="{% render 'nav-url', url: link_href, title: block.settings.title %}" role="listitem" data-reveal style="--i: {{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- assign link_icon = block.settings.icon | default: 'tag' -%}
            <span class="prop__icon">{% render 'icon', name: link_icon, px: 20 %}</span>
            <span class="nf__link-text">
              <strong>{% render 'tr', value: block.settings.title, key: block.settings.key_title %}</strong>
              {%- if block.settings.text != blank or block.settings.key_text != blank -%}<small class="muted">{% render 'tr', value: block.settings.text, key: block.settings.key_text %}</small>{%- endif -%}
            </span>
            {% render 'icon', name: 'arrow-up-right', px: 18 %}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if show_products and coll.products.size > 0 -%}
    <div class="nf__products">
      <div class="section-head">
        <div class="section-head__text" data-reveal>
          <p class="eyebrow">{{ 'page_404.popular_eyebrow' | t }}</p>
          <h2>{% render 'tr', value: s.products_heading, key: 'page_404.popular_heading' %}</h2>
        </div>
        <a href="{{ coll.url }}" class="btn btn--ghost btn--sm" data-reveal>{{ 'general.view_all' | t }}{% render 'icon', name: 'arrow-right', px: 16 %}</a>
      </div>
      <div class="product-grid" style="--cols: {{ limit | at_most: 4 }}">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, collection: coll, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "paragraph", "content": "Text fields left empty fall back to the theme's translations (English + Arabic)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Headline" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "Primary button" },
    { "type": "url", "id": "cta_url", "label": "Primary button link (blank = all products)" },
    { "type": "select", "id": "mascot", "label": "Penguin", "options": [
      { "value": "classic", "label": "Classic" }, { "value": "skate", "label": "Skate" }, { "value": "skate-spray", "label": "Spray can" }, { "value": "hoodie-sit", "label": "Hoodie, sitting" }, { "value": "boombox", "label": "Boombox" }
    ], "default": "classic" },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search box (popular terms come from Theme settings → Navigation)", "default": true },
    { "type": "header", "content": "Popular products" },
    { "type": "checkbox", "id": "show_products", "label": "Show popular products", "default": true },
    { "type": "text", "id": "products_heading", "label": "Heading (blank = translated)" },
    { "type": "collection", "id": "collection", "label": "Collection (blank = all products)" },
    { "type": "range", "id": "limit", "label": "How many", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title (blank = use translation key)" },
        { "type": "text", "id": "key_title", "label": "Translation key for title", "info": "e.g. nav.shop — leave both empty for none" },
        { "type": "text", "id": "text", "label": "Small text" },
        { "type": "text", "id": "key_text", "label": "Translation key for small text" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "tag", "label": "Tag" }, { "value": "needle", "label": "Needle" }, { "value": "palette", "label": "Palette" }, { "value": "truck", "label": "Truck" }, { "value": "message", "label": "Message" }, { "value": "heart", "label": "Heart" }, { "value": "search", "label": "Search" }, { "value": "grid", "label": "Grid" }
        ], "default": "tag" }
      ]
    }
  ],
  "presets": [ { "name": "404 page" } ]
}
{% endschema %}
