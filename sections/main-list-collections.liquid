<section class="collection wrap">
  <header class="collection__head glass" data-reveal>
    <div>
      <p class="eyebrow">LINUX</p>
      <h1 class="collection__title">{{ 'collections.title' | t }}</h1>
    </div>
  </header>
  <div class="collections-grid">
    {%- for c in collections -%}
      {%- if c.handle == 'frontpage' or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
      {%- assign img = c.image | default: c.products.first.featured_image -%}
      <a href="{{ c.url }}" class="bento__tile" data-reveal style="--i: {{ forloop.index0 | modulo: 4 }}">
        {%- if img -%}<img src="{{ img | image_url: width: 900 }}" alt="" width="900" height="1200" loading="lazy">{%- else -%}<img src="{{ 'brand-lookbook-2.webp' | asset_url }}" alt="" width="900" height="1200" loading="lazy">{%- endif -%}
        <span class="bento__label glass glass--solid"><span><strong>{% render 'menu-title', title: c.title %}</strong>{%- assign pc = c.products_count | default: 0 -%}{%- if pc > 0 -%}<small>{{ 'collections.count' | t: count: pc }}</small>{%- endif -%}</span><span class="bento__arrow">{% render 'icon', name: 'arrow-right', px: 18 %}</span></span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
