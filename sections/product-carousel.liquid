{%- liquid
  assign s = section.settings
  assign coll = s.collection
  if coll == blank
    assign coll = collections.all
  endif
  assign limit = s.limit | default: 8
-%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      <p class="eyebrow">{% if s.number != blank %}<span class="eyebrow__num">{{ s.number }}</span>{% endif %}{% render 'tr', value: s.eyebrow, key: 'home.bestsellers_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.bestsellers_heading' %}</h2>
    </div>
    <div class="rail__nav" data-reveal style="--i:1">
      <a href="{{ coll.url }}" class="btn btn--ghost btn--sm">{{ 'general.view_all' | t }}</a>
      <button class="icon-btn glass rail__btn" type="button" data-rail-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
      <button class="icon-btn glass rail__btn" type="button" data-rail-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  </div>
  <div class="rail" data-rail>
    <div class="rail__track">
      {%- for product in coll.products limit: limit -%}
        {% render 'product-card', product: product, collection: coll, index: forloop.index0 %}
      {%- else -%}
        {%- for i in (1..4) -%}<div class="card glass"><div class="card__media skeleton"></div><div class="card__body"><span class="skeleton" style="height:14px;border-radius:7px"></span></div></div>{%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product carousel",
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Section number",
      "default": "01"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product carousel"
    }
  ]
}
{% endschema %}
