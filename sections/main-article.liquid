<article class="article wrap">
  <header class="article__head" data-reveal>
    <nav class="crumbs"><a href="{{ blog.url }}">{{ blog.title }}</a>{% render 'icon', name: 'chevron-right', px: 12 %}<span>{% render 'date-ar', date: article.published_at %}</span></nav>
    <h1 class="article__title">{{ article.title }}</h1>
    <p class="muted">{{ 'blog.by' | t: author: article.author }} · {{ 'blog.min_read' | t: minutes: article.content | strip_html | size | divided_by: 1100 | at_least: 1 }}</p>
  </header>
  {%- if article.image -%}
    <div class="article__hero media" data-reveal><img src="{{ article.image | image_url: width: 1800 }}" alt="{{ article.image.alt | escape }}" loading="eager" width="1800" height="771"></div>
  {%- endif -%}
  <div class="article__body glass" data-reveal><div class="rte">{{ article.content }}</div></div>
  <footer class="article__foot">
    <div class="pills">{%- for tag in article.tags -%}<a class="chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}</div>
    <button class="btn btn--ghost btn--sm" type="button" data-copy="{{ shop.url }}{{ article.url }}" data-share>{% render 'icon', name: 'share', px: 16 %}{{ 'blog.share' | t }}</button>
  </footer>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
