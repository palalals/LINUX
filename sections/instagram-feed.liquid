{%- assign s = section.settings -%}
<section class="section wrap" id="s-{{ section.id }}">
  <div class="section-head">
    <div class="section-head__text" data-reveal>
      <p class="eyebrow">{% render 'tr', value: s.eyebrow, key: 'home.ugc_eyebrow' %}</p>
      <h2>{% render 'tr', value: s.heading, key: 'home.ugc_heading' %}</h2>
    </div>
    {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="btn btn--ghost btn--sm" target="_blank" rel="noopener" data-reveal>{% render 'icon', name: 'instagram', px: 18 %}{{ s.handle }}</a>{%- endif -%}
  </div>
  <div class="ugc">
    {%- for block in section.blocks -%}
      <a class="ugc__tile glass" href="{{ block.settings.link | default: settings.social_instagram }}" target="_blank" rel="noopener" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="" width="600" height="600" loading="lazy">
        {%- else -%}
          {%- assign fallbacks = 'brand-lookbook-1.webp,brand-lookbook-2.webp,brand-editorial.webp,brand-still-life.webp,brand-campaign.webp,brand-badge.webp' | split: ',' -%}
          <img src="{{ fallbacks[forloop.index0] | default: 'brand-still-life.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy">
        {%- endif -%}
        <span>{% render 'icon', name: 'instagram', px: 26 %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Instagram / UGC",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (blank = translated)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@linux.eg"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram / UGC",
      "blocks": [
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        },
        {
          "type": "post"
        }
      ]
    }
  ]
}
{% endschema %}
