{%- comment -%}
  Rendered server-side by Shopify's recommendations endpoint: product.js fetches
  /recommendations/products?section_id=…&product_id=… and swaps the inner HTML.
{%- endcomment -%}
<section class="section wrap" id="s-{{ section.id }}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section-head">
      <div class="section-head__text"><p class="eyebrow">{{ 'products.you_may_like' | t }}</p><h2>{% render 'tr', value: section.settings.heading, key: 'home.recommendations_heading' %}</h2></div>
    </div>
    <div class="product-grid" style="--cols: 4">
      {%- for p in recommendations.products -%}
        {% render 'product-card', product: p, index: forloop.index0 %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (blank = translated)"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ]
}
{% endschema %}
