<div class="drawer glass glass--solid" id="cart-drawer" data-drawer="cart" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" aria-hidden="true" inert>
  <div class="drawer__head">
    <h2 class="drawer__title">{{ 'cart.title' | t }} <span class="badge" data-cart-count>{{ cart.item_count }}</span></h2>
    <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  <div class="drawer__body">
    <div data-cart-region="body">
      {% render 'cart-body', cart: cart, context: 'drawer' %}
    </div>
    {%- if section.settings.show_upsell and settings.show_cart_upsell != false -%}
      <div class="cart-upsell" data-cart-upsell hidden>
        <p class="cart-upsell__title">{{ 'cart.upsell_title' | t }}</p>
        <div class="cart-upsell__list" data-cart-upsell-list></div>
      </div>
    {%- endif -%}
  </div>

  <div class="drawer__foot" data-cart-region="foot">
    {% render 'cart-foot', cart: cart, context: 'drawer' %}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "checkbox", "id": "show_upsell", "label": "Show \"Complete the look\" suggestions", "default": true }
  ]
}
{% endschema %}
