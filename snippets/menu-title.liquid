{%- comment -%}
  Menu/link title with automatic translation. Shopify translates menu titles
  through Translate & Adapt; when the merchant did that, the title arrives
  localised and is shown as-is. Otherwise common English labels fall back to
  nav.menu.* in the locale file. Titles that already contain Arabic letters
  (or anything the theme doesn't know) render unchanged.
  Usage: {% render 'menu-title', title: link.title %}
{%- endcomment -%}
{%- assign t_str = title | strip -%}
{%- assign k = t_str | downcase | replace: '&amp;', 'and' | replace: '&', 'and' | replace: ' ', '_' | replace: '-', '_' -%}
{%- assign is_key = false -%}
{%- if k != blank -%}
  {%- assign ascii_only = true -%}
  {%- assign probe = 'ا,ب,ت,ث,ج,ح,خ,د,ذ,ر,ز,س,ش,ص,ض,ط,ظ,ع,غ,ف,ق,ك,ل,م,ن,ه,و,ي,ى,ة,ء,أ,إ,آ,ؤ,ئ' | split: ',' -%}
  {%- for ch in probe -%}{%- if k contains ch -%}{%- assign ascii_only = false -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if ascii_only -%}{%- assign is_key = true -%}{%- endif -%}
{%- endif -%}
{%- if is_key -%}
  {%- assign key = 'nav.menu.' | append: k -%}
  {%- assign out = key | t -%}
  {%- assign out_lc = out | downcase -%}
  {%- if out_lc contains 'translation missing' -%}{{ title }}{%- else -%}{{ out }}{%- endif -%}
{%- else -%}
  {{ title }}
{%- endif -%}
