{%- comment -%}
  Page/blog content with an Arabic fallback. Shopify serves the Arabic version
  when the merchant translated the page in Translate & Adapt. Until then, an
  English page body would leak into the Arabic storefront — so if the Arabic
  page still carries no Arabic letters we show `fallback` (a theme string or
  section setting) instead.
  Usage: assign fb = 'home.about_body' | t, then {% render 'localized-content', content: page.content, fallback: fb %}
{%- endcomment -%}
{%- assign out = content -%}
{%- if request.locale.iso_code == 'ar' and content != blank -%}
  {%- assign plain = content | strip_html | strip -%}
  {%- assign has_arabic = false -%}
  {%- assign probe = 'ا,ب,ت,ل,م,ن,ه,و,ي,ع,ر,س,د,ق,ك,ف,ش,ح,ج,خ,ط,ص,ض,ظ,غ,ث,ذ,ز,ء,ى,ة' | split: ',' -%}
  {%- for ch in probe -%}{%- if plain contains ch -%}{%- assign has_arabic = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- unless has_arabic -%}
    {%- if fallback != blank -%}{%- assign out = fallback -%}{%- endif -%}
  {%- endunless -%}
{%- endif -%}
{{ out }}
