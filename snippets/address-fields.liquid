{%- assign a = address -%}
<div class="contact__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.first_name' | t }}</span><input class="input" type="text" name="address[first_name]" value="{{ a.first_name }}" autocomplete="given-name"></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.last_name' | t }}</span><input class="input" type="text" name="address[last_name]" value="{{ a.last_name }}" autocomplete="family-name"></label>
</div>
<label class="field"><span class="field__label">{{ 'customer.addresses.address1' | t }}</span><input class="input" type="text" name="address[address1]" value="{{ a.address1 }}" autocomplete="address-line1"></label>
<label class="field"><span class="field__label">{{ 'customer.addresses.address2' | t }}</span><input class="input" type="text" name="address[address2]" value="{{ a.address2 }}" autocomplete="address-line2"></label>
<div class="contact__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.city' | t }}</span><input class="input" type="text" name="address[city]" value="{{ a.city }}" autocomplete="address-level2"></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.province' | t }}</span><input class="input" type="text" name="address[province]" value="{{ a.province }}" autocomplete="address-level1"></label>
</div>
<div class="contact__row">
  <label class="field"><span class="field__label">{{ 'customer.addresses.country' | t }}</span><input class="input" type="text" name="address[country]" value="{{ a.country | default: 'Egypt' }}" autocomplete="country-name"></label>
  <label class="field"><span class="field__label">{{ 'customer.addresses.phone' | t }}</span><input class="input" type="tel" name="address[phone]" value="{{ a.phone }}" autocomplete="tel"></label>
</div>
<label class="checkbox"><input type="checkbox" name="address[default]"{% if a == customer.default_address %} checked{% endif %}> {{ 'customer.addresses.set_default' | t }}</label>
