{%- comment -%}
  Product card. Params: product, collection (URL context), show_quick (default
  true), lazy (default true), index (for reveal stagger).

  Quick add: one-variant products add directly; multi-variant products expose a
  size row where each pill carries its own variant id, resolved against the
  colour currently shown so the bag gets what the shopper saw.
{%- endcomment -%}
{%- liquid
  assign show_quick = show_quick | default: true, allow_false: true
  if settings.card_quick_add == false
    assign show_quick = false
  endif
  assign lazy = lazy | default: true, allow_false: true
  assign url = product.url
  if collection and collection.handle != 'all'
    assign url = product.url | within: collection
  endif
  assign on_sale = false
  if product.compare_at_price_max > product.price_min
    assign on_sale = true
  endif
  assign is_new = false
  if product.published_at
    assign published_s = product.published_at | date: '%s' | plus: 0
    assign now_s = 'now' | date: '%s' | plus: 0
    assign age = now_s | minus: published_s
    if age < 3456000
      assign is_new = true
    endif
  endif
  assign showing = product.selected_or_first_available_variant

  assign size_option = null
  for opt in product.options_with_values
    assign lower = opt.name | downcase
    if lower == 'size' or lower == 'sizes' or lower == 'المقاس' or lower == 'مقاس'
      assign size_option = opt
      break
    endif
  endfor
  unless size_option
    assign size_option = product.options_with_values | last
  endunless
  assign size_index = size_option.position | minus: 1

  assign color_option = null
  for opt in product.options_with_values
    assign lower = opt.name | downcase
    if lower == 'color' or lower == 'colour' or lower == 'اللون'
      assign color_option = opt
      break
    endif
  endfor
  assign alt_image = product.images[1]
-%}
<article class="card glass glass--hover" data-tilt data-product-card data-handle="{{ product.handle }}" data-reveal style="--i: {{ index | default: 0 | modulo: 4 }}">
  <div class="card__media">
    <a href="{{ url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        <img class="card__img--main" src="{{ product.featured_image | image_url: width: 720 }}" srcset="{{ product.featured_image | image_url: width: 360 }} 360w, {{ product.featured_image | image_url: width: 720 }} 720w, {{ product.featured_image | image_url: width: 1000 }} 1000w" sizes="(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 25vw" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="720" height="960" loading="{% if lazy %}lazy{% else %}eager{% endif %}" decoding="async">
        {%- if alt_image -%}
          <img class="card__img--alt" data-src="{{ alt_image | image_url: width: 540 }}" alt="" width="540" height="720" loading="lazy" decoding="async" aria-hidden="true" data-hover-only>
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}
      {%- endif -%}
    </a>
    <div class="card__badges">
      {%- unless product.available -%}<span class="chip chip--soldout">{{ 'products.sold_out' | t }}</span>
      {%- elsif on_sale -%}<span class="chip chip--sale">{{ 'products.sale' | t }}</span>
      {%- elsif is_new -%}<span class="chip chip--accent">{{ 'products.new' | t }}</span>{%- endunless -%}
    </div>
    {%- if settings.show_wishlist != false -%}
    <button class="card__wish" type="button" data-wishlist-toggle="{{ product.handle }}" aria-label="{{ 'wishlist.add' | t }}" aria-pressed="false">
      {% render 'icon', name: 'heart', px: 18 %}{% render 'icon', name: 'heart-fill', px: 18 %}
    </button>
    {%- endif -%}
    {%- if show_quick and product.available -%}
      <div class="card__quick glass glass--solid">
        {%- if product.has_only_default_variant -%}
          <button class="btn btn--cream btn--sm btn--block" type="button" data-quick-add="{{ product.first_available_variant.id }}">{% render 'icon', name: 'plus', px: 16 %}{{ 'products.quick_add' | t }}</button>
        {%- else -%}
          <span class="card__quick-title">{{ 'products.quick_add' | t }} · {% render 'option-name', name: size_option.name %}</span>
          <div class="card__sizes">
            {%- for value in size_option.values -%}
              {%- liquid
                assign match = null
                for v in product.variants
                  assign same_size = false
                  if v.options[size_index] == value
                    assign same_size = true
                  endif
                  if same_size
                    assign same_rest = true
                    for opt in product.options_with_values
                      assign oi = opt.position | minus: 1
                      if oi != size_index and v.options[oi] != showing.options[oi]
                        assign same_rest = false
                      endif
                    endfor
                    if same_rest
                      assign match = v
                      break
                    endif
                  endif
                endfor
              -%}
              {%- if match and match.available -%}
                <button class="card__size" type="button" data-quick-add="{{ match.id }}" aria-label="{{ 'products.add_size' | t: size: value }}">{{ value | upcase }}</button>
              {%- else -%}
                <button class="card__size" type="button" disabled aria-label="{{ 'products.size_unavailable' | t: size: value }}">{{ value | upcase }}</button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <button class="btn btn--ghost btn--sm btn--block" type="button" data-quick-view="{{ product.handle }}">{% render 'icon', name: 'eye', px: 16 %}{{ 'products.quick_view' | t }}</button>
      </div>
    {%- endif -%}
  </div>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ url }}">{% render 'product-title', title: product.title %}</a></h3>
    <div class="card__price">{% render 'price', product: product %}</div>
    {%- if color_option and color_option.values.size > 1 -%}
      <div class="card__swatches" aria-label="{% render 'option-name', name: color_option.name %}">
        {%- for value in color_option.values limit: 5 -%}
          {% render 'swatch', value: value, small: true %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</article>
