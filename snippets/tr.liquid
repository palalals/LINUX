{%- comment -%}
  Outputs a merchant setting when set, otherwise the theme translation — so
  every section switches language unless the merchant typed custom copy.
  Usage: {% render 'tr', value: s.heading, key: 'home.campaign_heading' %}
  Add `escape: true` for attribute contexts.
{%- endcomment -%}
{%- if value != blank -%}
  {%- if escape -%}{{ value | escape }}{%- else -%}{{ value }}{%- endif -%}
{%- elsif key != blank -%}
  {%- if escape -%}{{ key | t | escape }}{%- else -%}{{ key | t }}{%- endif -%}
{%- endif -%}
