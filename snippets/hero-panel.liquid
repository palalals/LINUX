{%- comment -%}
  The hero's glass panel (headline · subheading · CTAs) + trust row. Rendered
  either under the video (default) or floating over it, from hero-embroidery.
  Params: s (section.settings), eyebrow, heading, sub, cta, cta2 (resolved strings)
{%- endcomment -%}
{%- liquid
  assign primary_href = s.cta_url | default: routes.all_products_collection_url
  assign secondary_href = s.cta2_url | default: routes.collections_url
-%}
<div class="hero__strip glass" data-specular data-reveal>
  {%- unless s.show_headline == false -%}
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{{ eyebrow | escape }}</p>
      <h1 class="hero__title display" data-split>{{ heading | escape }}</h1>
    </div>
  {%- endunless -%}
  <div class="hero__side">
    <p class="hero__sub">{{ sub | escape }}</p>
    {%- unless s.show_cta == false -%}
      <div class="hero__cta">
        <a href="{% render 'nav-url', url: primary_href %}" class="btn btn--primary btn--lg" data-magnetic>{{ cta | escape }}{% render 'icon', name: 'arrow-right' %}</a>
        {%- if cta2 != blank -%}<a href="{% render 'nav-url', url: secondary_href %}" class="btn btn--glass btn--lg" data-magnetic>{{ cta2 | escape }}</a>{%- endif -%}
      </div>
    {%- endunless -%}
  </div>
</div>

{%- if s.show_trust -%}
  {%- liquid
    assign t1 = s.trust_1
    if t1 == blank
      assign t1 = 'sections.hero.trust_1' | t
    endif
    assign t2 = s.trust_2
    if t2 == blank
      assign t2 = 'sections.hero.trust_2' | t
    endif
    assign t3 = s.trust_3
    if t3 == blank
      assign t3 = 'sections.hero.trust_3' | t
    endif
  -%}
  <ul class="hero__trust" role="list" data-reveal style="--i: 3">
    <li>{% render 'icon', name: 'truck', px: 16 %}<span>{{ t1 | escape }}</span></li>
    <li>{% render 'icon', name: 'return', px: 16 %}<span>{{ t2 | escape }}</span></li>
    <li>{% render 'icon', name: 'needle', px: 16 %}<span>{{ t3 | escape }}</span></li>
  </ul>
{%- endif -%}
