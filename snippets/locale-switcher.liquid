{%- comment -%}
  Language pill. Shows the language you will switch TO, in its own script.
  Params: class (optional, e.g. 'locale-switcher--block' for the drawer).
{%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- assign form_id = 'localization-' | append: class | default: 'localization-header' | handleize -%}
  {%- form 'localization', id: form_id, class: 'locale-switcher' -%}
    {%- for lang in localization.available_languages -%}
      {%- unless lang.iso_code == localization.language.iso_code -%}
        <button class="locale-switcher__btn glass glass--pill{% if class %} {{ class }}{% endif %}" type="submit" name="language_code" value="{{ lang.iso_code }}" lang="{{ lang.iso_code }}" dir="{% if lang.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}" aria-label="{{ lang.endonym_name }}" title="{{ lang.endonym_name }}">
          {% render 'icon', name: 'globe', px: 15 %}<span>{{ lang.endonym_name }}</span>
        </button>
      {%- endunless -%}
    {%- endfor -%}
    <input type="hidden" name="return_to" value="{{ request.path }}">
  {%- endform -%}
{%- endif -%}
