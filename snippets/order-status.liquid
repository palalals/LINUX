{%- comment -%}
  Order status pill. Uses the theme's own translation when it knows the status
  key; otherwise falls back to Shopify's localised label.
  Usage: {% render 'order-status', status: order.financial_status, label: order.financial_status_label, icon: 'check' %}
{%- endcomment -%}
{%- assign key = 'customer.status.' | append: status -%}
{%- assign txt = key | t -%}
{%- assign txt_lc = txt | downcase -%}
{%- if txt_lc contains 'translation missing' or status == blank -%}{%- assign txt = label -%}{%- endif -%}
<span class="status status--{{ status }}">{% if icon %}{% render 'icon', name: icon, px: 12 %}{% endif %}{{ txt }}</span>
