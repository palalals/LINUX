{%- comment -%} Size guide drawer. Uses the merchant's size-guide page if set, else a built-in oversized chart. {%- endcomment -%}
{%- assign guide_page = settings.size_guide_page -%}
<div class="drawer glass glass--solid" data-drawer="size-guide" role="dialog" aria-modal="true" aria-label="{{ 'size_guide.title' | t }}" aria-hidden="true" inert>
  <div class="drawer__head">
    <h2 class="drawer__title">{% render 'icon', name: 'ruler', px: 20 %}{{ 'size_guide.title' | t }}</h2>
    <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__body">
    {%- if guide_page != blank and pages[guide_page].content != blank -%}
      <div class="rte">{{ pages[guide_page].content }}</div>
    {%- else -%}
      <p class="muted small" style="margin-bottom:16px">{{ 'size_guide.intro' | t }}</p>
      <div class="glass" style="padding:6px;border-radius:var(--r-md)">
        <table class="table size-table">
          <thead><tr><th>{{ 'size_guide.size' | t }}</th><th>{{ 'size_guide.chest' | t }}</th><th>{{ 'size_guide.length' | t }}</th><th>{{ 'size_guide.sleeve' | t }}</th><th>{{ 'size_guide.fits' | t }}</th></tr></thead>
          <tbody>
            <tr><td><strong>M</strong></td><td>60</td><td>72</td><td>60</td><td>165–175</td></tr>
            <tr><td><strong>L</strong></td><td>63</td><td>75</td><td>62</td><td>172–182</td></tr>
            <tr><td><strong>XL</strong></td><td>66</td><td>78</td><td>64</td><td>178–188</td></tr>
            <tr><td><strong>2XL</strong></td><td>69</td><td>81</td><td>66</td><td>185–195</td></tr>
          </tbody>
        </table>
      </div>
      <div class="glass glass--clear" style="display:flex;gap:12px;align-items:center;padding:14px 16px;margin-top:14px;border-radius:var(--r-md)">
        {% render 'mascot', name: 'hoodie-sit', width: 56 %}
        <p class="small">{{ 'size_guide.tip' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>
