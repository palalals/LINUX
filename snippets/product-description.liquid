{%- comment -%}
  Product description with an Arabic fallback. Shopify returns the translated
  description when the merchant filled it in Translate & Adapt; if the Arabic
  page still receives English copy (no translation yet), we show the theme's
  Arabic product copy (Theme settings → Product copy) so no English paragraph
  leaks into the Arabic storefront. Merchants can override per product with a
  metafield `custom.description_ar` (rich text or multi-line).
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign ar_meta = product.metafields.custom.description_ar -%}
  {%- if ar_meta != blank -%}
    {{ ar_meta | metafield_tag }}
  {%- else -%}
    {%- assign plain = product.description | strip_html | strip -%}
    {%- assign has_arabic = false -%}
    {%- assign probe = 'ا,ب,ت,ل,م,ن,ه,و,ي,ع,ر,س,د,ق,ك,ف,ش,ح,ج,خ,ط,ص,ض,ظ,غ,ث,ذ,ز,ء,ى,ة' | split: ',' -%}
    {%- for ch in probe -%}{%- if plain contains ch -%}{%- assign has_arabic = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
    {%- if has_arabic or plain == blank -%}
      {{ product.description }}
    {%- else -%}
      {%- assign ptype = product.type | downcase -%}
      {%- if ptype contains 'shirt' or ptype contains 'tee' or product.title contains 'Shirt' -%}
        {%- if settings.desc_ar_tee != blank -%}{{ settings.desc_ar_tee }}{%- else -%}{{ 'products.desc_ar_tee' | t }}{%- endif -%}
      {%- else -%}
        {%- if settings.desc_ar_hoodie != blank -%}{{ settings.desc_ar_hoodie }}{%- else -%}{{ 'products.desc_ar_hoodie' | t }}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- else -%}
  {{ product.description }}
{%- endif -%}
