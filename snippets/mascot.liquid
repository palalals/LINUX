{%- comment -%}
  Brand penguin. name: classic | skate | skate-spray | hoodie-sit | boombox
  width: rendered width in px. Transparent WebP with alpha, so it floats on glass.
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'classic'
  assign w = width | default: 160
  assign file = 'mascot-' | append: n | append: '.webp'
  assign ratio = 1.0
  case n
    when 'classic'
      assign ratio = 0.954
    when 'skate-spray'
      assign ratio = 0.961
    when 'hoodie-sit'
      assign ratio = 0.963
    when 'skate'
      assign ratio = 0.831
    when 'boombox'
      assign ratio = 0.853
  endcase
  assign h = w | divided_by: ratio | round
-%}
<img class="mascot mascot--{{ n }}{% if class %} {{ class }}{% endif %}" src="{{ file | asset_url }}" alt="{{ alt | default: '' }}" width="{{ w }}" height="{{ h }}" loading="{{ loading | default: 'lazy' }}" decoding="async" draggable="false">
