{%- comment -%}
  Localised date. Shopify localises %B month names for the storefront locale on
  the real store; the dev harness doesn't, so Arabic month names are mapped
  explicitly here — result is identical on both.
  Usage: {% render 'date-ar', date: order.created_at %}
{%- endcomment -%}
{%- if request.locale.iso_code == 'ar' -%}
  {%- assign m = date | date: '%m' | plus: 0 -%}
  {%- assign months = 'يناير,فبراير,مارس,أبريل,مايو,يونيو,يوليو,أغسطس,سبتمبر,أكتوبر,نوفمبر,ديسمبر' | split: ',' -%}
  {%- assign idx = m | minus: 1 -%}
  {{ date | date: '%e' | strip }} {{ months[idx] }} {{ date | date: '%Y' }}
{%- else -%}
  {{ date | date: format: 'month_day_year' }}
{%- endif -%}
