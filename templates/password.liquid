{%- comment -%} Storefront password page (store not yet open / launching). Uses layout/password.liquid. {%- endcomment -%}
{% layout 'password' %}
<section class="password wrap">
  <div class="auth">
    <div class="auth__panel glass" data-specular>
      <div class="auth__mascot"><img src="{{ 'mascot-classic.webp' | asset_url }}" alt="" width="240" height="240" loading="eager"></div>
      <p class="eyebrow">{{ shop.name }}</p>
      <h1>{{ 'password.title' | t }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="muted">{{ shop.password_message }}</p>
      {%- else -%}
        <p class="muted">{{ 'password.body' | t }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'password-newsletter', class: 'newsletter__form glass glass--pill' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
        <label class="visually-hidden" for="password-email">{{ 'newsletter.placeholder' | t }}</label>
        <input class="input" id="password-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
        <button class="btn btn--primary" type="submit">{{ 'newsletter.button' | t }}</button>
      {%- endform -%}

      <details class="password__enter">
        <summary class="btn btn--ghost btn--sm">{{ 'password.enter' | t }}</summary>
        {%- form 'storefront_password', class: 'password__form' -%}
          {{ form.errors | default_errors }}
          <label class="field"><span class="field__label">{{ 'password.password' | t }}</span><input class="input" type="password" name="password" autocomplete="current-password" required></label>
          <button class="btn btn--cream btn--block" type="submit">{{ 'password.submit' | t }}</button>
        {%- endform -%}
      </details>
    </div>
    <p class="muted" style="text-align:center;font-size:12px">{{ 'password.powered_html' | t }}</p>
  </div>
</section>
