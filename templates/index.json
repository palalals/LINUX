{
  "sections": {
    "hero": {
      "type": "hero-embroidery",
      "settings": {
        "height": 100,
        "height_mobile": 100,
        "overlay": 0,
        "layout": "below",
        "show_headline": true,
        "show_cta": true,
        "cta_url": "/collections/winter-collection",
        "cta2_url": "/pages/customize",
        "show_trust": true
      }
    },
    "marquee": {
      "type": "marquee",
      "blocks": {
        "m1": { "type": "item", "settings": { "key": "home.marquee_1" } },
        "m2": { "type": "item", "settings": { "key": "home.marquee_2" } },
        "m3": { "type": "item", "settings": { "key": "home.marquee_3" } },
        "m4": { "type": "item", "settings": { "key": "home.marquee_4" } },
        "m5": { "type": "item", "settings": { "key": "home.marquee_5" } }
      },
      "block_order": ["m1", "m2", "m3", "m4", "m5"],
      "settings": {}
    },
    "bestsellers": {
      "type": "product-carousel",
      "settings": {
        "number": "01",
        "collection": "winter-collection",
        "limit": 8
      }
    },
    "collections": {
      "type": "featured-collections",
      "blocks": {
        "c1": { "type": "collection", "settings": { "collection": "winter-collection", "size": "large" } },
        "c2": { "type": "collection", "settings": { "collection": "summer-collection", "size": "small" } },
        "c3": { "type": "collection", "settings": { "collection": "customize-print", "size": "small", "key_label": "home.collections_customize_label", "key_sub": "home.collections_customize_sub" } },
        "c4": { "type": "collection", "settings": { "collection": "all", "size": "wide", "key_label": "home.collections_all_label" } }
      },
      "block_order": ["c1", "c2", "c3", "c4"],
      "settings": { "number": "02" }
    },
    "campaign": {
      "type": "campaign",
      "settings": {
        "primary_link": "/collections/winter-collection",
        "secondary_link": "/pages/customize"
      }
    },
    "props": {
      "type": "value-props",
      "blocks": {
        "p1": { "type": "prop", "settings": { "icon": "truck", "key_title": "home.prop_1_title", "key_text": "home.prop_1_text" } },
        "p2": { "type": "prop", "settings": { "icon": "package", "key_title": "home.prop_2_title", "key_text": "home.prop_2_text" } },
        "p3": { "type": "prop", "settings": { "icon": "return", "key_title": "home.prop_3_title", "key_text": "home.prop_3_text" } },
        "p4": { "type": "prop", "settings": { "icon": "needle", "key_title": "home.prop_4_title", "key_text": "home.prop_4_text" } }
      },
      "block_order": ["p1", "p2", "p3", "p4"],
      "settings": {}
    },
    "faq": {
      "type": "faq",
      "blocks": {
        "q1": { "type": "question", "settings": { "key_q": "home.faq_1_q", "key_a": "home.faq_1_a" } },
        "q2": { "type": "question", "settings": { "key_q": "home.faq_2_q", "key_a": "home.faq_2_a" } },
        "q3": { "type": "question", "settings": { "key_q": "home.faq_3_q", "key_a": "home.faq_3_a" } },
        "q4": { "type": "question", "settings": { "key_q": "home.faq_4_q", "key_a": "home.faq_4_a" } }
      },
      "block_order": ["q1", "q2", "q3", "q4"],
      "settings": { "open_first": true }
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {}
    }
  },
  "order": [
    "hero",
    "marquee",
    "bestsellers",
    "collections",
    "campaign",
    "props",
    "faq",
    "newsletter"
  ]
}
