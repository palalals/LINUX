<!doctype html>
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar'
    assign is_rtl = true
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}" class="no-js" data-scheme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#043020">
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}">
  <title>{{ shop.name }} &ndash; {{ 'gift_card.title' | t }}</title>
  {%- unless settings.type_system_fonts -%}{% render 'fonts', is_rtl: is_rtl %}{%- endunless -%}
  {{ 'glass.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {% style %}
    .gift { min-height: 100svh; display: grid; place-items: center; padding: 40px 0; }
    .gift__card { width: min(100%, 520px); display: grid; gap: 20px; padding: clamp(24px, 3vw, 40px); border-radius: var(--r-hero); text-align: center; }
    .gift__value { font: 800 clamp(40px, 6vw, 64px) var(--font-display); letter-spacing: -.03em; line-height: 1; }
    .gift__code { display: inline-flex; align-items: center; gap: 12px; padding: 10px 10px 10px 18px; font: 600 18px var(--font-mono); letter-spacing: .12em; }
    .gift__qr { display: grid; justify-items: center; gap: 8px; }
    .gift__qr img, .gift__qr canvas { background: #fff; padding: 10px; border-radius: 16px; width: 140px; height: 140px; }
    .gift__actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
    @media print { .atmosphere, .gift__actions, .btn { display: none !important; } .gift__card { border: 1px solid #ccc; } }
  {% endstyle %}
  {{ content_for_header }}
</head>
<body class="template-gift-card{% if is_rtl %} is-rtl{% endif %}">
  <div class="atmosphere" aria-hidden="true">
    <span class="atmosphere__orb atmosphere__orb--a"></span>
    <span class="atmosphere__orb atmosphere__orb--b"></span>
    <span class="atmosphere__grain"></span>
  </div>
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
