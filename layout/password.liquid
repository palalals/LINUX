<!doctype html>
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar'
    assign is_rtl = true
  endif
  assign scheme = settings.color_scheme | default: 'forest'
-%}
<html lang="{{ request.locale.iso_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}" class="no-js" data-scheme="{% if scheme == 'cream' %}light{% else %}dark{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{% if scheme == 'cream' %}#efe4d2{% else %}#043020{% endif %}">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}">
  <title>{{ shop.name }} &ndash; {{ 'password.title' | t }}</title>
  <meta name="description" content="{{ shop.description | default: shop.name | escape }}">
  <meta name="robots" content="noindex">

  {%- unless settings.type_system_fonts -%}{% render 'fonts', is_rtl: is_rtl %}{%- endunless -%}

  {{ 'glass.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {% style %}
    :root { --page-max: {{ settings.page_width | default: 1440 }}px; }
    .password { min-height: 100svh; display: grid; place-items: center; padding-block: 40px; }
    .password .auth__mascot img { width: 140px; height: auto; }
    .password__enter { display: grid; justify-items: center; gap: 12px; }
    .password__enter summary { list-style: none; }
    .password__enter summary::-webkit-details-marker { display: none; }
    .password__form { width: 100%; display: grid; gap: 12px; }
  {% endstyle %}
  {{ content_for_header }}
</head>
<body class="template-password{% if is_rtl %} is-rtl{% endif %}">
  <div class="atmosphere" aria-hidden="true">
    <span class="atmosphere__orb atmosphere__orb--a"></span>
    <span class="atmosphere__orb atmosphere__orb--b"></span>
    <span class="atmosphere__orb atmosphere__orb--c"></span>
    <span class="atmosphere__grain"></span>
  </div>
  <header class="wrap" style="padding-top:20px;display:flex;justify-content:center">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">{% render 'brand-logo', height: 28 %}</a>
  </header>
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'glass.js' | asset_url }}" defer></script>
</body>
</html>
